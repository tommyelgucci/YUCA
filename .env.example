# Copia este archivo a .env.local y rellena los valores.
# Sin estas variables la web sigue funcionando: usa los datos de lib/data/ y
# oculta el panel de administración.

# --- Base de datos (Supabase) ---------------------------------------------
# Son DOS cadenas distintas de la misma base (Project Settings → Database →
# Connection string). Cambia el puerto y para qué sirve cada una:
#
#   6543 = pooler en modo transacción → la usa la aplicación. Muchas conexiones
#          cortas, que es lo que hace un servidor web. El driver ya lleva
#          `prepare: false`, obligatorio detrás del pooler.
#   5432 = conexión de sesión o directa → la usan las migraciones. Ahí cada
#          sentencia puede caer en una conexión distinta, y una migración son
#          varias sentencias que tienen que compartir transacción.
#
# Si sólo pones DATABASE_URL con el puerto 6543, `npm run db:migrate` falla.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Autenticación (Clerk) -------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Rutas de Clerk (no hace falta tocarlas)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/crear-cuenta

# --- Sitio -----------------------------------------------------------------
# Dominio público; se usa para las miniaturas de Open Graph.
NEXT_PUBLIC_SITE_URL=https://proyectoyuca.com

# --- Tareas programadas ----------------------------------------------------
# Secreto que protege /api/cron/expirar-reservas. Genera uno largo al azar.
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio
